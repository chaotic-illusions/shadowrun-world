# Keep the build context lean and avoid baking dev/secret files into the image.
# IMPORTANT: Docker does NOT read .gitignore -- this file is the only thing that keeps
# the local DB, git history, and the virtualenv out of `COPY . .` in the Dockerfile.

# Git / CI / local tooling
.git/
.gitignore
.githooks/
.github/

# Python virtualenv + caches
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local database + WAL sidecars (runtime uses the ./data volume mount, never the image copy)
data/
*.db
*.db-wal
*.db-shm

# Dev-only / editor / session artifacts
localdev.ps1
chat-session-resources/
workspaceStorage/
*.log

# Docs: keep docs/ai_parser_reference.md (read at runtime by narrative_parser) and the small
# design .md files; drop the heavy reference scrapes, generated PDFs, and review CSVs.
# The fillable sheet template IS needed at runtime (server-side PDF generation), so keep it.
docs/*.pdf
!docs/SR2_Official_Sheet_Fillable.pdf
docs/*.csv
docs/reference-data/

# Dev-only trees. fill_sr2_sheet.py IS imported at runtime (the /sheet.pdf endpoint), so keep it.
tools/*
!tools/fill_sr2_sheet.py
tests/
